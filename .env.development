# 開発環境（`next dev`）用のデフォルト環境変数。
# ここに書いた値は `next dev` 実行時のみ読み込まれ、本番ビルドには含まれない。
# ローカルの Supabase（`supabase start`）へ接続する設定。
# ここに書かれたURL/キーはローカル専用の固定値（誰の環境でも同じ）なのでコミットして問題ない。
# 個人的に上書きしたい場合は .env.local を作成する（.env.local は .env.development より優先される）。

# ローカル Supabase の API エンドポイントと anon キー（`supabase start` の出力と同じ既定値）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# 開発環境では認証をスキップしてログインなしでアクセスできるようにする。
# 本番ビルド（`next build`）ではこのファイルは読み込まれないため、認証は常に有効。
NEXT_PUBLIC_DISABLE_AUTH=true
